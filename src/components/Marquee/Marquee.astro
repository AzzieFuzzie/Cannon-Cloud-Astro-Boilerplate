---
import DataImage from '../DataImage/DataImage.astro';

interface MarqueeImage {
    image: string;
    alt?: string;
}

interface Props {
    images: MarqueeImage[];
    direction?: 'left' | 'right';
    // Seconds for one full loop
    duration?: number;
    class?: string;
}

const { images, direction = 'left', duration = 35, class: propsClass, ...rest } = Astro.props;

const classes = ['c-marquee', direction === 'right' && '-reverse', propsClass];
---

{
    images.length > 0 && (
        <div
            class:list={classes}
            style={`--marquee-duration: ${duration}s;`}
            data-scroll
            data-scroll-repeat
            data-scroll-offset="-50%,-50%"
            {...rest}
        >
            <div class="c-marquee_track">
                {/* The group is rendered twice so the loop is seamless; the copy is hidden from assistive tech */}
                {[0, 1].map((copy) => (
                    <div class="c-marquee_group" aria-hidden={copy === 1 ? 'true' : undefined}>
                        {images.map((item) => (
                            /* Not lazy: an image moving in from the side would only start loading
                            once it was on screen, and show blank until it arrived. Decoded sync:
                            an image painted before it is decoded (Safari drops the decoded pixels
                            of off-screen images) is drawn late rather than blank for a frame */
                            <DataImage
                                class="c-marquee_image"
                                src={item.image}
                                alt={copy === 1 ? '' : (item.alt ?? '')}
                                widths={[180, 250, 360, 500]}
                                sizes="(max-width: 699px) 180px, 250px"
                                loading="eager"
                                fetchpriority="low"
                                decoding="sync"
                            />
                        ))}
                    </div>
                ))}
            </div>
        </div>
    )
}

<style>
    @import 'Marquee.css';
</style>
