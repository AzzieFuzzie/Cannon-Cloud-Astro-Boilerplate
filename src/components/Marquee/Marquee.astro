---
import DataImage from '../DataImage/DataImage.astro';

interface MarqueeImage {
    image: string;
    alt?: string;
}

interface Props {
    images: MarqueeImage[];
    direction?: 'left' | 'right';
    // Seconds for one full loop
    duration?: number;
    class?: string;
}

const { images, direction = 'left', duration = 35, class: propsClass, ...rest } = Astro.props;

const classes = ['c-marquee', direction === 'right' && '-reverse', propsClass];
---

{
    images.length > 0 && (
        <div class:list={classes} style={`--marquee-duration: ${duration}s;`} {...rest}>
            <div class="c-marquee_track">
                {/* The group is rendered twice so the loop is seamless; the copy is hidden from assistive tech */}
                {[0, 1].map((copy) => (
                    <div class="c-marquee_group" aria-hidden={copy === 1 ? 'true' : undefined}>
                        {images.map((item) => (
                            <DataImage
                                class="c-marquee_image"
                                src={item.image}
                                alt={copy === 1 ? '' : (item.alt ?? '')}
                                widths={[250, 500]}
                                sizes="250px"
                            />
                        ))}
                    </div>
                ))}
            </div>
        </div>
    )
}

<style>
    @import 'Marquee.css';
</style>
