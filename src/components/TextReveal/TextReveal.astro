---
interface Props {
    // lines: masked lines rise · chars: characters turn in · fill: characters fade in with the scroll
    type?: 'lines' | 'chars' | 'fill';
    // Delay in seconds
    delay?: number;
    // Lines only: when it starts (a ScrollTrigger start). By default as soon as the text enters the
    // screen; 'top 90%' matches the fade reveals, to keep it in step with one beside it
    start?: string;
    class?: string;
}

const { type = 'lines', delay, start, class: propsClass, ...rest } = Astro.props;

const classes = ['c-text-reveal', propsClass];
---

<c-text-reveal
    class:list={classes}
    data-type={type}
    data-delay={delay}
    data-start={start}
    {...rest}
>
    <slot />
</c-text-reveal>

<style>
    @import 'TextReveal.css';
</style>

<script>
    import('./TextReveal.ts');
</script>
