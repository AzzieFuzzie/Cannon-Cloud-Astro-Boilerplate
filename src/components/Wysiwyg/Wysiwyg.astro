---
interface Props {
    tag?:
        | 'div'
        | 'article'
        | 'section'
        | 'aside'
        | 'main'
        | 'h1'
        | 'h2'
        | 'h3'
        | 'h4'
        | 'h5'
        | 'h6'
        | 'p';
    class?: string;
}

const { tag = 'div', class: propsClass, ...rest } = Astro.props;

const Tag = tag || 'div';
---

{
    Astro.slots.has('default') && (
        <Tag class:list={['c-wysiwyg', propsClass]} {...rest}>
            <slot />
        </Tag>
    )
}

<style>
    @import 'Wysiwyg.css';
</style>
