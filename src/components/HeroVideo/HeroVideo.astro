---
/**
 * Looping background video streamed from Mux.
 *
 * The player is created once and kept alive between page changes, so coming back to a page
 * with the same video resumes instantly instead of starting a new stream.
 * With `warm`, nothing is shown: the stream is only prepared in the background
 * (used in the layout so the first visit to the home page is quick too).
 */
interface Props {
    // Mux playback ID (the part of the stream URL before ".m3u8")
    playbackId: string;
    maxResolution?: string;
    // Video time (s) used for the poster image; playback also starts there so the two match.
    // Not 0 by default: many clips open on a black frame.
    posterTime?: number;
    warm?: boolean;
    class?: string;
}

const {
    playbackId,
    maxResolution = '1080p',
    posterTime = 0.5,
    warm = false,
    class: propsClass,
    ...rest
} = Astro.props;

const classes = ['c-hero-video', propsClass];

// Shown until the stream is playing, in a size to suit the screen
const thumbnail = (width: number, format = 'webp') =>
    `https://image.mux.com/${playbackId}/thumbnail.${format}?time=${posterTime}&width=${width}`;
const poster = thumbnail(1920);
const posterSrcset = [640, 960, 1280, 1920, 2560]
    .map((width) => `${thumbnail(width)} ${width}w`)
    .join(', ');

// A tiny copy of the same frame, built into the page: it fills the hero at once, so it is never
// empty, even when the preloader stops waiting before the poster arrives on a slow connection
const getPlaceholder = async (): Promise<string | undefined> => {
    if (warm) return undefined;
    try {
        const response = await fetch(thumbnail(32, 'jpg'), { signal: AbortSignal.timeout(5000) });
        if (!response.ok) return undefined;
        const data = Buffer.from(await response.arrayBuffer()).toString('base64');
        return `url(data:image/jpeg;base64,${data})`;
    } catch {
        return undefined;
    }
};
const placeholder = await getPlaceholder();
---

{
    warm ? (
        <c-hero-video
            class="c-hero-video"
            data-playback-id={playbackId}
            data-max-resolution={maxResolution}
            data-poster-time={posterTime}
            data-warm
            hidden
        />
    ) : (
        <c-hero-video
            class:list={classes}
            data-playback-id={playbackId}
            data-max-resolution={maxResolution}
            data-poster-time={posterTime}
            style={placeholder && `background-image: ${placeholder}`}
            {...rest}
        >
            <img
                class="c-hero-video_poster"
                src={poster}
                srcset={posterSrcset}
                sizes="100vw"
                alt=""
                loading="eager"
                decoding="sync"
                fetchpriority="high"
                data-hero-video="poster"
            />
        </c-hero-video>
    )
}

<style>
    @import 'HeroVideo.css';
</style>

<script>
    import('./HeroVideo.ts');
</script>
