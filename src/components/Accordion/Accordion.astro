---
interface Props {
    label: string;
    class?: string;
    name?: string;
    // CloudCannon data-prop path for the label, makes it editable in the Visual Editor
    labelProp?: string;
}

const { label, name, labelProp, class: propsClass, ...rest } = Astro.props;

const classes = ['c-accordion', propsClass];
---

<c-accordion class:list={classes} {...rest}>
    <details class="c-accordion_details" name={name}>
        <summary class="c-accordion_summary">
            {
                labelProp ? (
                    <span data-editable="text" data-prop={labelProp} data-type="span">
                        {label}
                    </span>
                ) : (
                    <span>{label}</span>
                )
            }
            <span class="c-accordion_icon" aria-hidden="true">&darr;</span>
        </summary>
        <div class="c-accordion_content" data-accordion="content">
            <slot />
        </div>
    </details>
</c-accordion>

<style>
    @import 'Accordion.css';
</style>

<script>
    import('./Accordion.ts');
</script>
