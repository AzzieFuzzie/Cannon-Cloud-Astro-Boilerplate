---
import '@styles/main.css';
import { Font, type CssVariable } from 'astro:assets';
// import { SEO } from 'astro-seo';
// import { defaultSeo } from '@data/seo';
import Icon from '../components/Icon/Icon.astro';

// Include ALL 3 font CSS variables declared in your astro.config.mjs
const FONTS: CssVariable[] = ['--custom-lato', '--custom-rd-narrow', '--custom-rd-condensed'];
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />

        <!-- Render all font variables dynamically -->
        {FONTS.map((font) => <Font cssVariable={font} preload />)}
    </head>
    <body>
        <script src="../scripts/app.ts"></script>

        <div class="container grid grid-cols-2 py-fluid-md">
            <div>
                <!-- <Icon name="logo" /> -->
            </div>
            <nav class="body-base flex gap-gutter justify-self-end uppercase">
                <a href="/">Home</a>
                <a href="/about">Our Story</a>
                <a href="/post">Menu</a>
                <a href="/contact">Contact</a>
                <a href="/book">Book a Reservation</a>
            </nav>
        </div>

        <main id="swup" class="transition-fade">
            <div id="content">
                <slot />
            </div>
        </main>

        <footer class="w-full bg-black py-16 text-white">
            <div class="grid-12 container items-center text-center">
                {/* Left Block: Trading Hours (Spans cols 1–5 on desktop) */}
                <div class="col-span-12 space-y-4 lg:col-span-5 lg:text-left">
                    <h5
                        data-editable="source"
                        data-path="src/layouts/Layout.astro"
                        data-key="footerTradingHeading"
                        class="text-body font-medium tracking-widest text-[var(--color-gold)] uppercase"
                    >
                        TRADING HOURS
                    </h5>

                    <div class="space-y-3 text-sm text-white/90">
                        {/* Mon-Thu */}
                        <div
                            class="flex flex-col space-y-1 lg:max-w-xs lg:flex-row lg:items-center lg:justify-between lg:space-y-0"
                        >
                            <span>Mon-Thu</span>
                            <span>12:00pm - 10:30pm</span>
                        </div>

                        {/* Fri-Sat */}
                        <div
                            class="flex flex-col space-y-1 lg:max-w-xs lg:flex-row lg:items-center lg:justify-between lg:space-y-0"
                        >
                            <span>Fri-Sat</span>
                            <span>12:00pm - 12:00am</span>
                        </div>

                        {/* Sun */}
                        <div
                            class="flex flex-col space-y-1 lg:max-w-xs lg:flex-row lg:items-center lg:justify-between lg:space-y-0"
                        >
                            <span>Sun</span>
                            <span>12:00pm - 10:30pm</span>
                        </div>
                    </div>
                </div>

                {/* Right Block: Contact Us & Social Links (Spans cols 8–12 on desktop) */}
                <div
                    class="col-span-12 space-y-6 text-center lg:col-span-5 lg:col-start-8 lg:text-right"
                >
                    {/* Contact Section */}
                    <div class="space-y-2">
                        <h5
                            data-editable="source"
                            data-path="src/layouts/Layout.astro"
                            data-key="footerContactHeading"
                            class="text-body font-medium tracking-widest text-[var(--color-gold)] uppercase"
                        >
                            CONTACT US
                        </h5>

                        <p>
                            <a href="tel:+27118848899" class="hover:text-gold transition-colors">
                                +27 11 884 8899
                            </a>
                        </p>
                        <p class="font-medium tracking-wide uppercase">
                            <a
                                href="mailto:ADMIN@PIGALLE.CO.ZA"
                                class="hover:text-gold transition-colors"
                            >
                                ADMIN@PIGALLE.CO.ZA
                            </a>
                        </p>
                    </div>

                    {/* Social Links */}
                    <div class="space-y-2">
                        <h5
                            data-editable="source"
                            data-path="src/layouts/Layout.astro"
                            data-key="footerSocialHeading"
                            class="text-body font-medium tracking-widest text-[var(--color-gold)] uppercase"
                        >
                            FOLLOW US
                        </h5>

                        <div
                            class="flex items-center justify-center space-x-4 text-white lg:justify-end"
                        >
                            {/* Facebook */}
                            <a
                                href="https://facebook.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Facebook"
                                class="hover:text-gold transition-colors"
                            >
                                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                                    <path
                                        d="M12 2C6.477 2 2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.879V14.89h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.989C18.343 21.129 22 16.99 22 12c0-5.523-4.477-10-10-10z"
                                    ></path>
                                </svg>
                            </a>

                            {/* Instagram */}
                            <a
                                href="https://instagram.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="Instagram"
                                class="hover:text-gold transition-colors"
                            >
                                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                                    <path
                                        d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                                    ></path>
                                </svg>
                            </a>

                            {/* X / Twitter */}
                            <a
                                href="https://x.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="X Twitter"
                                class="hover:text-gold transition-colors"
                            >
                                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                                    <path
                                        d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
                                    ></path>
                                </svg>
                            </a>

                            {/* TikTok */}
                            <a
                                href="https://tiktok.com"
                                target="_blank"
                                rel="noopener noreferrer"
                                aria-label="TikTok"
                                class="hover:text-gold transition-colors"
                            >
                                <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24">
                                    <path
                                        d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.98-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.29-2.58.74-5.2 2.67-6.88 1.11-.98 2.52-1.58 3.99-1.72.38-.04.76-.05 1.14-.02v4.11c-.55-.05-1.12.02-1.63.22-.88.33-1.58 1.05-1.89 1.94-.36 1.01-.18 2.18.47 3.02.66.86 1.73 1.34 2.81 1.25 1.06-.03 2.05-.6 2.58-1.52.32-.53.47-1.15.46-1.77.01-4.83.01-9.66.01-14.49z"
                                    ></path>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                {/* Left: Logo */}
                <div
                    class="col-span-12 flex items-center justify-center border-t border-white/10 pt-8 lg:col-span-6 lg:justify-start"
                >
                    <img
                        src="src/assets/svgs/logo.svg"
                        alt="Pigalle by Villamoura Restaurant Logo"
                        class="h-10 w-auto"
                    />
                </div>

                {/* Right: Copyright & Agency Credits */}
                <div
                    class="col-span-12 flex items-center justify-center pt-2 lg:col-span-6 lg:justify-end lg:border-t lg:border-white/10 lg:pt-8"
                >
                    <p class="text-xs text-white/60">
                        © 2026 Pigalle by Villamoura <span class="text-gold mx-1">X</span> Goodbye Friday
                    </p>
                </div>
            </div>
        </footer>

        <script>
            import { setViewportSize } from '@scripts/utils/setViewportSize';
            import { $screenDebounce } from '@scripts/stores/screen';

            // Set viewport size
            $screenDebounce.subscribe(() => {
                setViewportSize();
            });
        </script>
    </body>
</html>
