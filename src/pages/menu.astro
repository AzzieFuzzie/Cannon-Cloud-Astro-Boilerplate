---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Layout.astro';
import Menu from '../components/Menu/Menu.astro';
import about from '../data/about.json';
import { getMenuSchema } from '@scripts/utils/schema';

const slugify = (str: string) =>
    str
        .toLowerCase()
        .trim()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)/g, '');

const menuCategories = (await getCollection('menu'))
    .filter((c) => c.data.items.length > 0)
    .sort((a, b) => (a.data.displayOrder ?? 0) - (b.data.displayOrder ?? 0))
    .map((c) => ({
        slug: slugify(c.data.categoryName),
        name: c.data.categoryName,
        image: c.data.image ?? about.aboutHeroImage,
        imageAlt: c.data.imageAlt,
        items: c.data.items,
        // CloudCannon path to this category's JSON file, used by the editable regions in the Menu component
        cmsFile: `@file[/${c.filePath ?? `src/content/menu/${c.id}.json`}]`
    }));

// Dishes and prices as schema.org data ("<" escaped so the JSON can't close its script tag)
const menuSchema = JSON.stringify(getMenuSchema(menuCategories, Astro.site!)).replace(
    /</g,
    '\\u003c'
);
---

<Layout
    title="Menu"
    description="Seafood, flame-grilled meats, platters, pasta and desserts: explore the Pigalle by Villamoura menu."
>
    <script is:inline slot="head" type="application/ld+json" set:html={menuSchema} />
    <Menu categories={menuCategories} />
</Layout>
