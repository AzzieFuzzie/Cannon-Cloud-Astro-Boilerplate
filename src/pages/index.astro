---
import Layout from '@layouts/Layout.astro';
import home from '../data/home.json';

import Image from 'astro/components/Image.astro';
import Accordion from '../components/Accordion/Accordion.astro';
---

<Layout title="Home">
    <div class="space-y-fluid-4xl">
        {/* Hero Section */}
        <section
            class="relative flex h-dvh w-screen items-end justify-end overflow-x-hidden p-fluid-md"
            data-animation="pin"
        >
            <div
                class="pointer-events-none absolute right-fluid-md bottom-fluid-md z-10 max-w-[clamp(90ch,70%,120ch)] text-right"
                data-animation="title"
            >
                <div class="hero__text" data-animation="title">
                    <div
                        class="heading-h1 text-white"
                        data-editable="source"
                        data-key="slogan"
                        data-type="text"
                        data-path="src/pages/index.astro"
                    >
                        <p>
                            Pigalle <em>by</em> Villamoura <em>the</em> home <em>of</em> Exceptional
                            Seafood <em>and</em> Grills
                        </p>
                    </div>
                </div>
            </div>

            <mux-background-video
                class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover select-none"
                src="https://stream.mux.com/NfIIb02VK5Q2dFP3yFW01jvFZ02HI98JD8SNaM4CQRzUCs.m3u8"
                max-resolution="1080p"
                preload="auto"
                muted
                autoplay
                loop></mux-background-video>
        </section>
        <section class="mx-auto max-w-[clamp(80ch,70vw,90ch)]" data-animation="fade">
            <div class="grid text-center">
                <h2
                    data-editable="source"
                    data-path="src/pages/index.astro"
                    data-key="taglineHeading"
                    data-type="text"
                    data-animation="text"
                    class="heading-h2 mb-fluid-md"
                >
                    Nestled in the heart of Sandton at Nelson Mandela Square, Pigalle by Villamoura
                    offers more than just a meal — it’s an experience.
                </h2>
                <a class="button" href="/book/" data-animation="fade">
                    <span
                        data-editable="source"
                        data-path="src/pages/index.astro"
                        data-key="taglineButton"
                        data-type="text"
                        class="button__label"
                    >
                        Book A Reservation
                    </span>
                </a>
            </div>
        </section>
    </div>

    {/* About Section */}
    <section class="container grid grid-cols-1 items-center gap-gutter lg:grid-cols-2">
        <div class="w-full">
            <div class="overflow-hidden">
                <Image
                    class="h-auto w-full object-cover"
                    data-editable="image"
                    data-prop-src="@data[home].aboutImageSrc"
                    data-prop-alt="@data[home].aboutImageAlt"
                    data-prop-title="@data[home].aboutImageTitle"
                    src={home.aboutImageSrc}
                    title={home.aboutImageTitle}
                    alt={home.aboutImageAlt}
                    data-animation="image_reveal_horizontal"
                    width={1000}
                    height={1000}
                />
            </div>
        </div>

        <div class="lg:pl-fluid-md">
            <h6
                data-editable="source"
                data-path="src/pages/index.astro"
                data-key="aboutSubheading"
                data-type="text"
                class="heading-h6 pb-fluid-xs font-medium tracking-widest text-black/60 uppercase"
            >
                ABOUT
            </h6>

            <h2
                data-editable="source"
                data-path="src/pages/index.astro"
                data-key="aboutDescription"
                data-type="text"
                class="heading-h3 max-w-[28ch] pb-fluid-xs leading-snug font-normal text-black"
            >
                Pigalle by Villamoura serves Portuguese and Mediterranean Inspired cuisine with a
                classic South African twist.
            </h2>

            <div class="">
                <a
                    class="inline-block border-b border-black pb-1 text-xs font-semibold tracking-widest text-black uppercase transition-opacity hover:opacity-70"
                    href="/about/"
                >
                    <span
                        data-editable="source"
                        data-path="src/pages/index.astro"
                        data-key="aboutButton"
                        data-type="text"
                    >
                        OUR STORY
                    </span>
                </a>
            </div>
        </div>
    </section>

    {/* Our Menu Section */}
    <section
        class="lg:grid-col-start container grid grid-cols-1 items-center gap-gutter lg:grid-cols-2"
    >
        <div class="order-1 w-full lg:order-2">
            <div>
                <div data-animation="image_reveal_horizontal">
                    <div data-animation="carousel">
                        <Image
                            class="h-auto w-full object-cover"
                            sizes="(max-width: 600px) 650px, (max-width: 1440px) 50vw, 700px"
                            data-editable="image"
                            data-prop-src="@data[home].foodGalleryImage"
                            data-prop-alt="@data[home].foodGalleryImageAlt"
                            data-prop-title="@data[home].foodGalleryImageTitle"
                            src={home.foodGalleryImage}
                            title={home.foodGalleryImageTitle}
                            alt={home.foodGalleryImageAlt}
                            width={1000}
                            height={1000}
                        />
                    </div>
                </div>
            </div>
        </div>

        <div class="order-2 lg:order-1">
            <h6
                data-editable="source"
                data-path="src/pages/index.astro"
                data-key="foodHeading"
                data-type="text"
                class="heading-h6 pb-fluid-xs font-medium tracking-widest text-black/60 uppercase"
            >
                The Menu
            </h6>
            <p
                data-editable="source"
                data-path="src/pages/index.astro"
                data-key="foodDescription"
                data-type="text"
                class="heading-h3 pb-fluid-xs font-medium tracking-widest uppercase"
            >
                From ocean-fresh seafood to flame-grilled perfection.
            </p>

            <a class="button" href="/menu/">
                <span
                    data-editable="source"
                    data-path="src/pages/index.astro"
                    data-key="foodButton"
                    data-type="text"
                    class="button__label"
                >
                    Explore Plates
                </span>
            </a>
        </div>
    </section>

    {/* Private Events Section */}
    <section
        class="grid-12 relative min-h-screen w-full items-center overflow-hidden bg-black text-white"
    >
        <div class="absolute inset-0 z-0">
            <Image
                class="h-full w-full object-cover object-center"
                data-editable="image"
                data-prop-src="@data[home].eventsImageSrc"
                data-prop-alt="@data[home].eventsImageAlt"
                data-prop-title="@data[home].eventsImageTitle"
                src={home.eventsImageSrc}
                title={home.eventsImageTitle}
                alt={home.eventsImageAlt}
                width={1000}
                height={1000}
            />
        </div>

        <div class="relative z-10 col-start-6 col-end-12 py-fluid-xl">
            <div class="max-w-[40rem] px-fluid-sm lg:px-0">
                <h2
                    data-editable="source"
                    data-path="src/pages/index.astro"
                    data-key="eventsHeading"
                    data-type="text"
                    class="heading-h2 font-serif leading-tight text-white"
                    data-animation="title"
                >
                    Private Events
                </h2>

                <p
                    data-editable="source"
                    data-path="src/pages/index.astro"
                    data-key="eventsDescription"
                    data-type="text"
                    class="max-w-[34ch] text-sm leading-relaxed text-white/90 md:text-base"
                    data-animation="paragraph"
                >
                    We accommodate for all types of events including birthdays, corporate event,
                    pre-wedding occasions and more.
                </p>

                <div class="pt-fluid-xs">
                    <a
                        class="hover:text-accent-grey hover:border-accent-grey inline-block border-b border-white pb-1 text-xs font-semibold tracking-widest text-white uppercase transition-colors"
                        href="/book/"
                        data-animation="fade"
                    >
                        <span
                            data-editable="source"
                            data-path="src/pages/index.astro"
                            data-key="eventsButton"
                            data-type="text"
                        >
                            MAKE A BOOKING
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>

<section class="container py-fluid-xl" aria-labelledby="faq-heading">
    <div class="mx-auto max-w-[clamp(50ch,70vw,80ch)]">
        <p class="heading-h6 mb-fluid-xs font-medium tracking-widest text-black/60 uppercase">
            Frequently Asked Questions
        </p>
        <h2 id="faq-heading" class="heading-h2 mb-fluid-lg">Everything you need to know</h2>

        <div class="border-t border-black/20">
            <Accordion label="Do I need a reservation?" name="faq" class="border-b border-black/20">
                <p class="max-w-[60ch] pb-fluid-sm text-sm leading-relaxed text-black/70">
                    Reservations are recommended, especially for evenings and weekends. Walk-ins are
                    welcome and will be seated subject to availability.
                </p>
            </Accordion>

            <Accordion
                label="What cuisine do you serve?"
                name="faq"
                class="border-b border-black/20"
            >
                <p class="max-w-[60ch] pb-fluid-sm text-sm leading-relaxed text-black/70">
                    Our menu brings together Portuguese and Mediterranean-inspired dishes with a
                    classic South African twist, including fresh seafood and flame-grilled
                    favourites.
                </p>
            </Accordion>

            <Accordion
                label="Do you cater for dietary requirements?"
                name="faq"
                class="border-b border-black/20"
            >
                <p class="max-w-[60ch] pb-fluid-sm text-sm leading-relaxed text-black/70">
                    We are happy to accommodate most dietary requirements. Please let our team know
                    when making your reservation so we can prepare the best experience for you.
                </p>
            </Accordion>

            <Accordion
                label="Can I host a private event at Pigalle?"
                name="faq"
                class="border-b border-black/20"
            >
                <p class="max-w-[60ch] pb-fluid-sm text-sm leading-relaxed text-black/70">
                    Yes. We host birthdays, corporate events, pre-wedding occasions and more.
                    Contact us to discuss your plans and available options.
                </p>
            </Accordion>

            <Accordion label="Where are you located?" name="faq" class="border-b border-black/20">
                <p class="max-w-[60ch] pb-fluid-sm text-sm leading-relaxed text-black/70">
                    You can find us in the heart of Sandton at Nelson Mandela Square. Visit our
                    booking page for directions and reservation details.
                </p>
            </Accordion>
        </div>
    </div>
</section>
