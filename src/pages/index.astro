---
import Layout from '@layouts/Layout.astro';
import Button from '@components/Button/Button.astro';
import Wysiwyg from '@components/Wysiwyg/Wysiwyg.astro';
import Accordion from '@components/Accordion/Accordion.astro';

const eventsBackgroundImage =
    'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=1600&auto=format&fit=crop&q=80';
const eventsImageAlt = 'Private events ambiance';

const reviews = [
    {
        text: 'He went out of his way to make our Anniversary special. Thank you for the wonderful service and delicious food!',
        name: 'SIBABALO'
    },
    {
        text: 'Pigalle Restaurant in Sandton offers a refined dining experience, perfect for those looking to enjoy a blend of Mediterranean and continental cuisine in an elegant setting.',
        name: 'PAUL GOVENDER'
    },
    {
        text: '5 star venue for sure, everything is just so consistent from the great setup to the delicious food!',
        name: 'DAN M'
    },
    {
        text: '5 star venue for sure, everything is just so consistent from the great setup to the delicious food!',
        name: 'DAN M'
    },
    {
        text: '5 star venue for sure, everything is just so consistent from the great setup to the delicious food!',
        name: 'DAN M'
    }
];

const faqs = [
    {
        key: 'faq1',
        question: 'Do I need to make a reservation?',
        answer: 'We highly recommend making a reservation in advance, especially for weekend dining and group bookings.'
    },
    {
        key: 'faq2',
        question: 'Is your restaurant kid-friendly?',
        answer: 'Yes, we welcome families and offer seating options suitable for dining with children.'
    },
    {
        key: 'faq3',
        question: 'Do you accommodate food allergies?',
        answer: 'Absolutely. Please inform your server of any dietary requirements or allergies so our culinary team can accommodate you.'
    },
    {
        key: 'faq4',
        question: 'Do you offer takeaways or deliveries?',
        answer: 'We offer takeaway collection directly from the restaurant. Delivery options are available through select partners.'
    },
    {
        key: 'faq5',
        question: 'Can I host a private event at your restaurant?',
        answer: 'Yes, we offer custom private dining and event packages for birthdays, corporate functions, and celebrations.'
    }
];
---

<Layout title="Home">
    <div class="space-y-fluid-4xl">
        {/* Hero Section */}
        <section
            class="relative flex h-dvh w-screen items-end justify-end overflow-x-hidden p-fluid-md"
            data-animation="pin"
            data-editable="source"
            data-path="/src/pages/index.astro"
            data-key="heroSection"
        >
            {/* Title Container */}
            <div
                class="pointer-events-none absolute right-fluid-md bottom-fluid-md z-10 max-w-[clamp(90ch,70%,120ch)] text-right"
                data-animation="title"
            >
                <div class="hero__text" data-animation="title">
                    <div
                        class="heading-h1 text-white"
                        data-editable="source"
                        data-key="slogan"
                        data-path="/src/pages/index.astro"
                    >
                        <p>
                            Pigalle <em>by</em> Villamoura <em>the</em> home <em>of</em> Exceptional Seafood
                            <em>and</em> Grills
                        </p>
                    </div>
                </div>
            </div>

            {/* Background Video */}
            <mux-background-video
                class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover select-none"
                src="https://stream.mux.com/NfIIb02VK5Q2dFP3yFW01jvFZ02HI98JD8SNaM4CQRzUCs.m3u8"
                max-resolution="1080p"
                preload="auto"
                muted
                autoplay
                loop
            >
                <img
                    slot="poster"
                    src="https://image.mux.com/NfIIb02VK5Q2dFP3yFW01jvFZ02HI98JD8SNaM4CQRzUCs/thumbnail.webp?time=0.5&width=1920"
                    alt="Pigalle Background Video Layout Poster"
                    class="h-full w-full object-cover"
                    data-editable="source"
                    data-path="/src/pages/index.astro"
                    data-key="heroPosterImage"
                />
            </mux-background-video>
        </section>

        {/* Tagline Card Section */}
        <section
            class="mx-auto max-w-[clamp(80ch,70vw,90ch)]"
            data-animation="fade"
            data-editable="source"
        >
            <div
                class="grid text-center"
                data-editable="source"
                data-path="/src/pages/index.astro"
                data-key="taglineContainer"
            >
                <h2
                    data-editable="source"
                    data-path="/src/pages/index.astro"
                    data-key="taglineHeading"
                    data-animation="text"
                    class="heading-h2 mb-fluid-md"
                >
                    Nestled in the heart of Sandton at Nelson Mandela Square, Pigalle by Villamoura
                    offers more than just a meal — it’s an experience.
                </h2>
                <a class="button" href="/book/" data-animation="fade">
                    <span
                        data-editable="source"
                        data-path="/src/pages/index.astro"
                        data-key="taglineButton"
                        class="button__label"
                    >
                        Book A Reservation
                    </span>
                </a>
            </div>
        </section>
    </div>

    {/* About Section */}
    <section class="container grid grid-cols-1 items-center gap-gutter lg:grid-cols-2">
        {/* Left: Image */}
        <div class="w-full">
            <div class="overflow-hidden">
                <img
                    class="h-auto w-full object-cover"
                    src="https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1000&auto=format&fit=crop&q=85"
                    alt="Oyster dining table dish"
                    data-animation="image_reveal_horizontal"
                    data-editable="source"
                    data-path="/src/pages/index.astro"
                    data-key="aboutImage"
                />
            </div>
        </div>

        {/* Right: Text Content */}
        <div class="lg:pl-fluid-md">
            <h6
                data-editable="source"
                data-path="/src/pages/index.astro"
                data-key="aboutSubheading"
                class="heading-h6 pb-fluid-xs font-medium tracking-widest text-black/60 uppercase"
            >
                ABOUT
            </h6>

            <h2
                data-editable="source"
                data-path="/src/pages/index.astro"
                data-key="aboutDescription"
                class="heading-h3 max-w-[28ch] pb-fluid-xs leading-snug font-normal text-black"
            >
                Pigalle Villamoura serves Portuguese and Mediterranean Inspired cuisine with a
                classic South African twist.
            </h2>

            <div class="">
                <a
                    class="inline-block border-b border-black pb-1 text-xs font-semibold tracking-widest text-black uppercase transition-opacity hover:opacity-70"
                    href="/about/"
                >
                    <span
                        data-editable="source"
                        data-path="/src/pages/index.astro"
                        data-key="aboutButton"
                    >
                        OUR STORY
                    </span>
                </a>
            </div>
        </div>
    </section>

    {/* Our Food Section */}
    <section
        class="lg:grid-col-start container grid grid-cols-1 items-center gap-gutter lg:grid-cols-2"
    >
        <div class="order-1 w-full lg:order-2">
            <div>
                <div data-animation="image_reveal_horizontal">
                    <div data-animation="carousel">
                        <img
                            src="https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1000&auto=format&fit=crop&q=85"
                            sizes="(max-width: 600px) 650px, (max-width: 1440px) 50vw, 700px"
                            alt="Food platter"
                            data-editable="source"
                            data-path="/src/pages/index.astro"
                            data-key="foodGalleryImage"
                        />
                    </div>
                </div>
            </div>
        </div>

        <div class="order-2 lg:order-1">
            <h6
                data-editable="source"
                data-path="/src/pages/index.astro"
                data-key="foodHeading"
                class="heading-h6 pb-fluid-xs font-medium tracking-widest text-black/60 uppercase"
            >
                The Menu
            </h6>
            <p
                data-editable="source"
                data-path="/src/pages/index.astro"
                data-key="foodDescription"
                class="heading-h3 pb-fluid-xs font-medium tracking-widest uppercase"
            >
                From ocean-fresh seafood to flame-grilled perfection.
            </p>

            <a class="button" href="/menu/">
                <span
                    data-editable="source"
                    data-path="/src/pages/index.astro"
                    data-key="foodButton"
                    class="button__label"
                >
                    Explore Plates
                </span>
            </a>
        </div>
    </section>

    {/* Private Events Section */}
    <section
        class="grid-12 relative min-h-screen w-full items-center overflow-hidden bg-black text-white"
    >
        {/* Background Image & Overlay */}
        <div class="absolute inset-0 z-0">
            {
                eventsBackgroundImage && (
                    <img
                        src={eventsBackgroundImage}
                        alt={eventsImageAlt}
                        class="h-full w-full object-cover object-center"
                        data-editable="source"
                        data-path="/src/pages/index.astro"
                        data-key="eventsBackgroundImage"
                    />
                )
            }
        </div>

        {/* Content Wrapper */}
        <div class="relative z-10 col-start-6 col-end-12 py-fluid-xl">
            <div class="max-w-[40rem] px-fluid-sm lg:px-0">
                <h2
                    data-editable="source"
                    data-path="/src/pages/index.astro"
                    data-key="eventsHeading"
                    class="heading-h2 font-serif leading-tight text-white"
                    data-animation="title"
                >
                    Private Events
                </h2>

                <p
                    data-editable="source"
                    data-path="/src/pages/index.astro"
                    data-key="eventsDescription"
                    class="max-w-[34ch] text-sm leading-relaxed text-white/90 md:text-base"
                    data-animation="paragraph"
                >
                    We accommodate for all types of events including birthdays, corporate event,
                    pre-wedding occasions and more.
                </p>

                <div class="pt-fluid-xs">
                    <a
                        class="hover:text-accent-grey hover:border-accent-grey inline-block border-b border-white pb-1 text-xs font-semibold tracking-widest text-white uppercase transition-colors"
                        href="/book/"
                        data-animation="fade"
                    >
                        <span
                            data-editable="source"
                            data-path="/src/pages/index.astro"
                            data-key="eventsButton"
                        >
                            MAKE A BOOKING
                        </span>
                    </a>
                </div>
            </div>
        </div>

        {/* Bottom-Left Decorative Line Art SVG */}
        <div class="pointer-events-none absolute bottom-4 left-4 z-10 w-24 opacity-80 md:w-36">
            <svg
                viewBox="0 0 100 100"
                fill="none"
                stroke="currentColor"
                class="h-full w-full text-white"
            >
                {/* Citrus SVG path */}
            </svg>
        </div>
    </section>

    {/* Reviews Section */}
    <section class="section--small--padding reviews relative overflow-hidden py-20">
        <div class="reviews__wrapper mx-auto flex w-full max-w-7xl flex-col items-center px-4">
            <!-- Large Decorative Quote Mark -->
            <div class="reviews__quote__wrapper mb-8">
                <span class="reviews__quote font-serif text-6xl text-neutral-400">&ldquo;</span>
            </div>

            {/* Track Container */}
            <div class="reviews-track-container relative w-full">
                <div
                    class="reviews-track no-scrollbar flex items-center gap-6 overflow-x-auto px-[10%] pt-4 pb-8 md:px-[25%]"
                >
                    {
                        reviews.map((review, index) => (
                            <div
                                class="review-slide w-[85vw] shrink-0 scale-95 cursor-pointer opacity-30 blur-[0.5px] transition-all duration-300 md:w-[600px]"
                                data-index={index}
                            >
                                <div class="reviews__item flex flex-col items-center px-4 text-center">
                                    <h3 class="reviews__text mb-6">
                                        <p class="heading-h3 font-serif text-xl leading-relaxed text-neutral-900 md:text-3xl">
                                            {review.text}
                                        </p>
                                    </h3>
                                    <h6 class="reviews__name">
                                        <p class="heading-h6 text-xs font-semibold tracking-widest text-neutral-800 uppercase md:text-sm">
                                            - {review.name}
                                        </p>
                                    </h6>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            {/* Pagination Navigation Dots */}
            <div class="reviews-nav mt-8 flex items-center justify-center gap-3">
                {
                    reviews.map((_, index) => (
                        <button
                            class="review-dot h-2.5 w-2.5 rounded-full bg-neutral-300 transition-all duration-300"
                            data-index={index}
                            aria-label={`Go to slide ${index + 1}`}
                        />
                    ))
                }
            </div>
        </div>
    </section>
</Layout>
