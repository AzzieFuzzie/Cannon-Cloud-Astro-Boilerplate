---
import Layout from '@layouts/Layout.astro';
import Button from '@components/Button/Button.astro';
import Wysiwyg from '@components/Wysiwyg/Wysiwyg.astro';
import Accordion from '@components/Accordion/Accordion.astro';

const faqs = [
    {
        key: 'faq1',
        question: 'Do I need to make a reservation?',
        answer: 'We highly recommend making a reservation in advance, especially for weekend dining and group bookings.'
    },
    {
        key: 'faq2',
        question: 'Is your restaurant kid-friendly?',
        answer: 'Yes, we welcome families and offer seating options suitable for dining with children.'
    },
    {
        key: 'faq3',
        question: 'Do you accommodate food allergies?',
        answer: 'Absolutely. Please inform your server of any dietary requirements or allergies so our culinary team can accommodate you.'
    },
    {
        key: 'faq4',
        question: 'Do you offer takeaways or deliveries?',
        answer: 'We offer takeaway collection directly from the restaurant. Delivery options are available through select partners.'
    },
    {
        key: 'faq5',
        question: 'Can I host a private event at your restaurant?',
        answer: 'Yes, we offer custom private dining and event packages for birthdays, corporate functions, and celebrations.'
    }
];
---

<Layout title="Home">
    <div>
        <div class="home__wrapper">
            {/* Hero Section */}

            <section
                class="relative flex h-dvh w-screen items-end justify-end overflow-x-hidden p-fluid-md"
                data-animation="pin"
            >
                <!-- Title Container: Added z-10 so it stays ABOVE the video -->
                <div
                    class="pointer-events-none absolute right-fluid-md bottom-fluid-md z-10 max-w-[clamp(90ch,70%,120ch)] text-right"
                    data-animation="title"
                >
                    <h1
                        class="heading-h1 text-white"
                        data-editable="source"
                        data-path="/src/pages/index.astro"
                        data-key="slogan"
                    >
                        Pigalle by Villamoura the home of Exceptional Seafood and Grills =======
                        <section class="hero" data-animation="pin">
                            <div class="hero__text" data-animation="title">
                                <h1
                                    data-editable="source"
                                    data-path="/src/pages/index.astro"
                                    data-key="slogan"
                                >
                                    Pigalle by Villamoura the home of Exceptional cake >>>>>>>
                                    0a1bb90bd215dd053a60d40aa044d3ec9d34f5a4
                                </h1>
                            </div>

                            <!-- Background Video: Explicit z-0 -->
                            <mux-background-video
                                class="pointer-events-none absolute inset-0 z-0 h-full w-full object-cover select-none"
                                src="https://stream.mux.com/NfIIb02VK5Q2dFP3yFW01jvFZ02HI98JD8SNaM4CQRzUCs.m3u8"
                                max-resolution="1080p"
                                preload="auto"
                            >
                                <img
                                    slot="poster"
                                    src="https://image.mux.com/NfIIb02VK5Q2dFP3yFW01jvFZ02HI98JD8SNaM4CQRzUCs/thumbnail.webp?time=0.5&width=1920"
                                    alt="Pigalle Background Video Layout Poster"
                                    class="h-full w-full object-cover"
                                />
                            </mux-background-video>
                        </section>

                        {/* Tagline Card Section */}
                        <section
                            class="section-spacing-3xl mx-auto max-w-[clamp(80ch,70vw,90ch)]"
                            data-animation="fade"
                        >
                            <div class="grid text-center">
                                <h2
                                    data-editable="source"
                                    data-path="/src/pages/index.astro"
                                    data-key="taglineHeading"
                                    data-animation="text"
                                    class="heading-h2 mb-fluid-md"
                                >
                                    Nestled in the heart of Sandton at Nelson Mandela Square,
                                    Pigalle by Villamoura offers more than just a meal — it’s an
                                    experience.
                                </h2>
                                <a class="button" href="/book/" data-animation="fade">
                                    <span
                                        data-editable="source"
                                        data-path="/src/pages/index.astro"
                                        data-key="taglineButton"
                                        class="button__label">Book A Reservation</span
                                    >
                                </a>
                            </div>
                        </section>
                    </h1>

                    {/* About Section: 1 col on mobile -> 2 cols on desktop */}
                    <section
                        class="section-spacing-3xl container grid grid-cols-1 items-center gap-gutter lg:grid-cols-2"
                    >
                        {/* Left: Image (Column 1 on desktop) */}
                        <div class="w-full">
                            <div class="overflow-hidden">
                                <img
                                    class="h-auto w-full object-cover"
                                    src="https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1000&auto=format&fit=crop&q=85"
                                    alt="Oyster dining table dish"
                                    data-animation="image_reveal_horizontal"
                                />
                            </div>
                        </div>

                        {/* Right: Text Content (Column 2 on desktop) */}
                        <div class="space-y-fluid-sm lg:pl-fluid-md">
                            <h6
                                data-editable="source"
                                data-path="/src/pages/index.astro"
                                data-key="aboutSubheading"
                                class="heading-h6 font-medium tracking-widest text-black/60 uppercase"
                            >
                                ABOUT
                            </h6>

                            <h2
                                data-editable="source"
                                data-path="/src/pages/index.astro"
                                data-key="aboutDescription"
                                class="heading-h3 max-w-[28ch] leading-snug font-normal text-black"
                            >
                                Pigalle by Villamoura serves Portuguese and Mediterranean Inspired
                                cuisine with a classic South African twist.
                            </h2>

                            <div class="pt-fluid-xs">
                                <a
                                    class="inline-block border-b border-black pb-1 text-xs font-semibold tracking-widest text-black uppercase transition-opacity hover:opacity-70"
                                    href="/about/"
                                >
                                    <span
                                        data-editable="source"
                                        data-path="/src/pages/index.astro"
                                        data-key="aboutButton"
                                    >
                                        OUR STORY
                                    </span>
                                </a>
                            </div>
                        </div>
                    </section>
                    {/* Our Food Section */}
                    <section
                        class="section-spacing container grid grid-cols-1 items-center gap-gutter lg:grid-cols-2"
                    >
                        <div class="">
                            <h6
                                data-editable="source"
                                data-path="/src/pages/index.astro"
                                data-key="foodHeading"
                                class="heading-h6 font-medium tracking-widest text-black/60 uppercase"
                            >
                                The Menu
                            </h6>
                            <p
                                data-editable="source"
                                data-path="/src/pages/index.astro"
                                data-key="foodDescription"
                                class="heading-h3 font-medium tracking-widest text-black/60 uppercase"
                            >
                                From ocean-fresh seafood to flame-grilled perfection.
                            </p>
                            <a class="button" href="/menu/">
                                <span
                                    data-editable="source"
                                    data-path="/src/pages/index.astro"
                                    data-key="foodButton"
                                    class="button__label">Explore Plates</span
                                >
                            </a>
                        </div>

                        <div class="w-full">
                            <div class="">
                                <div class="" data-animation="image_reveal_horizontal">
                                    <div data-animation="carousel">
                                        <img
                                            src="https://images.unsplash.com/photo-1514933651103-005eec06c04b?w=1000&auto=format&fit=crop&q=85"
                                            sizes="(max-width: 600px) 650px, (max-width: 1440px) 50vw, 700px"
                                            alt="#"
                                        />
                                    </div>
                                </div>
                            </div>
                            {/* Component or placeholder for +svg-decorative('rosemary') */}
                            <!-- <svg class="svg-decorative--rosemary"></svg> -->
                        </div>
                    </section>
                    <div class="carousel__controls">
                        <button class="carousel__button">
                            <span class="btn__prev carousel__button__label">prev</span>
                        </button>
                        <button class="carousel__button">
                            <span class="btn__next carousel__button__label">next</span>
                        </button>
                        <div class="carousel__counter">
                            <span>food gallery</span>
                        </div>
                    </div>

                    {/* Private Events Section */}
                    <section
                        class="section-spacing relative h-full w-full overflow-hidden bg-black text-white"
                    >
                        {/* Full-width Background Image & Dark Overlay */}
                        <div class="absolute inset-0 z-0">
                            <img
                                src="https://images.unsplash.com/photo-1511795409834-ef04bbd61622?w=1600&auto=format&fit=crop&q=80"
                                alt="Private events ambiance"
                                class="h-full w-full object-cover object-center"
                                data-animation="scale"
                            />
                            <div class="absolute inset-0 bg-black/40"></div>
                        </div>

                        {/* Main Content Grid */}
                        <div class="grid-12 relative z-10 container min-h-[70vh] items-center">
                            {
                                /* Right Column Content (Spans cols 7–11 on desktop to match reference) */
                            }
                            <div
                                class="col-span-12 space-y-fluid-sm py-fluid-lg lg:col-span-5 lg:col-start-7"
                            >
                                <h2
                                    data-editable="source"
                                    data-path="/src/pages/index.astro"
                                    data-key="eventsHeading"
                                    class="heading-h2 font-serif leading-tight text-white"
                                    data-animation="title"
                                >
                                    Private Events
                                </h2>

                                <p
                                    data-editable="source"
                                    data-path="/src/pages/index.astro"
                                    data-key="eventsDescription"
                                    class="max-w-[34ch] text-sm leading-relaxed text-white/90 md:text-base"
                                    data-animation="paragraph"
                                >
                                    We accommodate for all types of events including birthdays,
                                    corporate event, pre-wedding occasions and more.
                                </p>

                                <div class="pt-fluid-xs">
                                    <a
                                        class="hover:text-accent-grey hover:border-accent-grey inline-block border-b border-white pb-1 text-xs font-semibold tracking-widest text-white uppercase transition-colors"
                                        href="/book/"
                                        data-animation="fade"
                                    >
                                        <span
                                            data-editable="source"
                                            data-path="/src/pages/index.astro"
                                            data-key="eventsButton"
                                        >
                                            MAKE A BOOKING
                                        </span>
                                    </a>
                                </div>
                            </div>
                        </div>

                        {/* Bottom-Left Decorative Line Art SVG */}
                        <div
                            class="pointer-events-none absolute bottom-4 left-4 z-10 w-24 opacity-80 md:w-36"
                        >
                            <svg
                                viewBox="0 0 100 100"
                                fill="none"
                                stroke="currentColor"
                                class="h-full w-full text-white"
                            >
                                {/* Insert your citrus/lemon line art SVG path here */}
                            </svg>
                        </div>
                    </section>

                    {/* FAQ Section */}
                    <section
                        class="bg-grey section-spacing relative w-full overflow-hidden text-black"
                    >
                        {/* Main 12-Column Grid Container */}
                        <div class="c-grid relative z-10 container">
                            {/* Centered Column Wrapper (Spans Cols 4 to 10 on Desktop) */}
                            <div class="col-span-12 lg:col-span-7 lg:col-start-4">
                                {/* Title */}
                                <h2
                                    data-editable="source"
                                    data-path="/src/pages/index.astro"
                                    data-key="faqHeading"
                                    class="heading-h2 mb-fluid-md font-serif text-black"
                                    data-animation="title"
                                >
                                    FAQ'S
                                </h2>

                                {/* Accordion Container */}
                                <div class="w-full border-t border-black/15" data-animation="faq">
                                    {
                                        faqs.map((faq, index) => (
                                            <div class="border-b border-black/15">
                                                <Accordion
                                                    label={faq.question}
                                                    name="faq-accordion"
                                                    class="group cursor-pointer py-fluid-xs text-base font-medium text-black md:text-lg"
                                                >
                                                    <p
                                                        data-editable="source"
                                                        data-path="/src/pages/index.astro"
                                                        data-key={`faqAnswer${index + 1}`}
                                                        class="pt-2 pb-4 text-sm leading-relaxed font-normal text-black/70 md:text-base"
                                                    >
                                                        {faq.answer}
                                                    </p>
                                                </Accordion>
                                            </div>
                                        ))
                                    }
                                </div>
                            </div>
                        </div>

                        {/* Decorative Bottom-Left Wheat Plant SVG */}
                        <div
                            class="pointer-events-none absolute bottom-0 left-0 z-0 w-32 opacity-40 md:w-56"
                        >
                            <svg
                                viewBox="0 0 200 300"
                                fill="none"
                                stroke="currentColor"
                                class="text-accent-grey h-full w-full"
                            >
                                {/* Insert bottom-left wheat plant SVG path here */}
                            </svg>
                        </div>

                        {/* Decorative Right-Edge Seed/Leaf Plant SVG */}
                        <div
                            class="pointer-events-none absolute top-1/2 right-0 z-0 w-36 -translate-y-1/2 opacity-40 md:w-64"
                        >
                            <svg
                                viewBox="0 0 200 300"
                                fill="none"
                                stroke="currentColor"
                                class="text-accent-grey h-full w-full"
                            >
                                {/* Insert right-side botanical leaf SVG path here */}
                            </svg>
                        </div>
                    </section>
                    {/* Reviews Section */}
                    <section
                        class="section--small--padding reviews"
                        data-animation="reviews_slider"
                    >
                        <div class="reviews__wrapper">
                            <div class="reviews__track">
                                <div class="reviews__quote__wrapper">
                                    <span class="reviews__quote">&ldquo;</span>
                                </div>
                                <div class="reviews__slider">
                                    <div class="reviews__slide">
                                        <div class="reviews__item">
                                            <h3
                                                data-editable="source"
                                                data-path="/src/pages/index.astro"
                                                data-key="reviewText1"
                                                class="reviews__text"
                                            >
                                                text
                                            </h3>
                                            <h6
                                                data-editable="source"
                                                data-path="/src/pages/index.astro"
                                                data-key="reviewName1"
                                                class="reviews__name"
                                            >
                                                name
                                            </h6>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div
                                class="reviews__dots"
                                role="tablist"
                                aria-label="Review Navigation"
                            >
                            </div>
                        </div>
                    </section>
                </div>
            </section>
        </div>
    </div></Layout
>
