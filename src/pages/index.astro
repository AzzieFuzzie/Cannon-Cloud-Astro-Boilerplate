---
import Layout from '@layouts/Layout.astro';
import home from '../data/home.json';

import Accordion from '../components/Accordion/Accordion.astro';
import Button from '../components/Button/Button.astro';
import Carousel from '../components/Carousel/Carousel.astro';
import DataImage from '../components/DataImage/DataImage.astro';
import Decor from '../components/Decor/Decor.astro';
import HeroVideo from '../components/HeroVideo/HeroVideo.astro';
import Marquee from '../components/Marquee/Marquee.astro';
import Reveal from '../components/Reveal/Reveal.astro';
import ReviewsSlider from '../components/ReviewsSlider/ReviewsSlider.astro';
import TextReveal from '../components/TextReveal/TextReveal.astro';
import { getGoogleReviews } from '@scripts/utils/googleReviews';

import mint from '../assets/svgs/mint.svg';
import rosemary from '../assets/svgs/rosemary.svg';
import seedPlant from '../assets/svgs/seed_plant.svg';
import wheat from '../assets/svgs/wheat.svg';

// Five-star Google reviews first, topped up to five from src/data/home.json (as the Pigalle app does)
const googleReviews = await getGoogleReviews();
const reviews = [...googleReviews, ...home.reviews].slice(0, 5);
---

<Layout title="Home">
    {/* Hero Section: sticks to the top while the rest of the page scrolls over it */}
    <section
        class="sticky top-0 flex h-[calc(100vh_-_var(--nav-height))] items-end justify-end overflow-y-hidden pr-tiny"
    >
        <div class="absolute z-10 max-w-[clamp(90ch,70%,120ch)]">
            <TextReveal type="chars">
                <p
                    class="heading-h1 text-right text-white"
                    data-editable="source"
                    data-key="slogan"
                    data-type="text"
                    data-path="src/pages/index.astro"
                >
                    Pigalle <em>by</em> Villamoura <em>the</em> home <em>of</em> Exceptional Seafood
                    <em>and</em> Grills
                </p>
            </TextReveal>
        </div>

        <HeroVideo
            playbackId={home.heroVideoPlaybackId}
            class="pointer-events-none absolute inset-0 z-0 select-none"
        />
    </section>

    {/* Everything below slides over the hero */}
    <div class="relative z-10 overflow-x-clip bg-(--color-grey) pt-large">
        {/* Tagline Section */}
        <section class="mx-xtiny mb-large flex items-center justify-center">
            <div class="flex max-w-[clamp(60ch,70vw,80ch)] flex-col items-center justify-center">
                <TextReveal type="fill">
                    <h2
                        data-editable="source"
                        data-path="src/pages/index.astro"
                        data-key="taglineHeading"
                        data-type="text"
                        class="heading-h2 mb-xsmall text-center"
                    >
                        Nestled in the heart of Sandton at Nelson Mandela Square, Pigalle by
                        Villamoura offers more than just a meal — it’s an experience.
                    </h2>
                </TextReveal>
                <Reveal type="fade">
                    <Button class="text-center text-black" href="/about" target="_blank">
                        <span
                            data-editable="source"
                            data-path="src/pages/index.astro"
                            data-key="taglineButton"
                            data-type="span">Our Story</span
                        >
                    </Button>
                </Reveal>
            </div>
        </section>

        {/* About Section */}
        <section class="container mb-medium">
            <div class="grid-layout gap-y-fluid-md items-center">
                {/* Image */}
                <div class="relative col-span-4 sm:col-span-6">
                    <Reveal type="clip-x" class="mb-tiny">
                        <DataImage
                            class="aspect-665/700 h-auto w-full object-cover"
                            sizes="(max-width: 600px) 650px, (max-width: 1440px) 50vw, 700px"
                            data-editable="image"
                            data-prop-src="@data[home].aboutImageSrc"
                            data-prop-alt="@data[home].aboutImageAlt"
                            data-prop-title="@data[home].aboutImageTitle"
                            src={home.aboutImageSrc}
                            title={home.aboutImageTitle}
                            alt={home.aboutImageAlt}
                        />
                    </Reveal>
                    <Decor
                        src={mint}
                        speed={0.1}
                        rotate={25}
                        class="-bottom-[8vh] -left-[5vw] max-sm:-right-[5vw] max-sm:-bottom-[5vh] max-sm:left-auto"
                    />
                </div>

                {/* Text */}
                <div
                    class="col-span-4 flex flex-col items-start text-left sm:col-span-4 sm:col-start-8"
                >
                    <p
                        data-editable="source"
                        data-path="src/pages/index.astro"
                        data-key="aboutSubheading"
                        data-type="text"
                        class="heading-h6 pb-fluid-xs mb-xtiny font-medium tracking-widest text-black/60 uppercase"
                    >
                        ABOUT
                    </p>

                    <h2
                        data-editable="source"
                        data-path="src/pages/index.astro"
                        data-key="aboutDescription"
                        data-type="text"
                        class="heading-h4 pb-fluid-xs mb-tiny max-w-[28ch] leading-snug font-normal text-black"
                    >
                        Pigalle by Villamoura serves Portuguese and Mediterranean Inspired cuisine
                        with a classic South African twist.
                    </h2>

                    <Button class="text-center text-black" href="/about">
                        <span
                            data-editable="source"
                            data-path="src/pages/index.astro"
                            data-key="aboutButton"
                            data-type="span">Our Story</span
                        >
                    </Button>
                </div>
            </div>
        </section>

        {/* Our Menu Section */}
        <section class="container mb-large">
            <div class="grid-layout gap-y-fluid-md items-center">
                {
                    /* Image carousel (first in the code = first on mobile); slides live in src/data/home.json */
                }
                <div
                    class="relative col-span-4 mb-tiny sm:col-span-6 sm:col-start-7 sm:row-start-1"
                >
                    <Reveal type="clip-x">
                        <Carousel images={home.foodGallery} />
                    </Reveal>
                    <Decor
                        src={rosemary}
                        speed={-0.1}
                        rotate={-20}
                        class="-right-[3vw] bottom-[2vh]"
                    />
                </div>

                {/* Text (left on desktop) */}
                <div class="col-span-4 sm:col-span-4 sm:col-start-3 sm:row-start-1">
                    <p
                        data-editable="source"
                        data-path="src/pages/index.astro"
                        data-key="foodHeading"
                        data-type="text"
                        class="heading-h6 pb-fluid-xs mb-xtiny font-medium tracking-widest text-black/60 uppercase"
                    >
                        Our Food
                    </p>

                    <h2
                        data-editable="source"
                        data-path="src/pages/index.astro"
                        data-key="foodDescription"
                        data-type="text"
                        class="heading-h4 pb-fluid-md mb-tiny max-w-[15ch] font-normal text-black"
                    >
                        From ocean-fresh seafood to flame-grilled perfection.
                    </h2>

                    <Button class="text-center text-black" href="/menu">
                        <span
                            data-editable="source"
                            data-path="src/pages/index.astro"
                            data-key="foodButton"
                            data-type="span">Our Menu</span
                        >
                    </Button>
                </div>
            </div>
        </section>

        {/* Private Events Section */}
        <Reveal
            type="scale"
            tag="section"
            class="grid-layout relative mb-large min-h-screen w-full items-center justify-items-center overflow-hidden text-white"
        >
            <div class="absolute inset-0 z-0">
                <DataImage
                    class="h-full w-full object-cover object-center"
                    data-editable="image"
                    data-prop-src="@data[home].eventsImageSrc"
                    data-prop-alt="@data[home].eventsImageAlt"
                    data-prop-title="@data[home].eventsImageTitle"
                    src={home.eventsImageSrc}
                    title={home.eventsImageTitle}
                    alt={home.eventsImageAlt}
                    sizes="100vw"
                />
            </div>

            <div class="relative z-10 col-span-3 col-start-2 py-large sm:col-start-7">
                <div class="max-w-[40rem] px-xsmall lg:px-0">
                    <TextReveal type="chars">
                        <h2
                            data-editable="source"
                            data-path="src/pages/index.astro"
                            data-key="eventsHeading"
                            data-type="text"
                            class="heading-h2 mb-xsmall font-serif leading-tight text-white"
                        >
                            Private Events
                        </h2>
                    </TextReveal>

                    <TextReveal>
                        <p
                            data-editable="source"
                            data-path="src/pages/index.astro"
                            data-key="eventsDescription"
                            data-type="text"
                            class="max-w-[34ch] text-sm leading-relaxed text-white/90 md:text-base"
                        >
                            We accommodate for all types of events including birthdays, corporate
                            event, pre-wedding occasions and more.test.
                        </p>
                    </TextReveal>

                    <Reveal type="fade" class="pt-small">
                        <a
                            class="hover:text-accent-grey hover:border-accent-grey inline-block border-b border-white pb-1 text-xs font-semibold tracking-widest text-white uppercase transition-colors"
                            href="/book/"
                        >
                            <span
                                data-editable="source"
                                data-path="src/pages/index.astro"
                                data-key="eventsButton"
                                data-type="text"
                            >
                                MAKE A BOOKING
                            </span>
                        </a>
                    </Reveal>
                </div>
            </div>
        </Reveal>

        <section class="relative mb-large" aria-labelledby="faq-heading">
            {/* Side margin so the questions and icons don't touch the screen edges on phones */}
            <div class="mx-auto max-w-[clamp(50ch,70vw,80ch)] px-(--grid-margin) md:px-0">
                <TextReveal type="chars">
                    <h2
                        id="faq-heading"
                        class="mb-tiny tracking-widest uppercase"
                        data-editable="source"
                        data-path="src/pages/index.astro"
                        data-key="faqHeading"
                        data-type="text"
                    >
                        FAQ&apos;S
                    </h2>
                </TextReveal>

                {
                    /* FAQs live in src/data/home.json so questions can be added, removed and reordered */
                }
                <div data-editable="array" data-prop="@data[home].faqs">
                    {
                        home.faqs.map((faq) => (
                            <div data-editable="array-item">
                                <Accordion label={faq.question} labelProp="question" name="faq">
                                    <p
                                        class="pb-fluid-sm max-w-[60ch] text-sm leading-relaxed text-black/70"
                                        data-editable="text"
                                        data-prop="answer"
                                        data-type="text"
                                    >
                                        {faq.answer}
                                    </p>
                                </Accordion>
                                {/* Divider line draws in from the left */}
                                <Reveal
                                    type="line"
                                    class="h-px bg-(--color-accent-grey) [--reveal-duration:1.5s]"
                                />
                            </div>
                        ))
                    }
                </div>
            </div>

            <Decor
                src={wheat}
                speed={0.15}
                rotate={15}
                class="top-[20vh] -left-[3vw] max-sm:hidden"
            />
            <Decor
                src={seedPlant}
                speed={-0.1}
                rotate={-25}
                class="top-[5vh] -right-[3vw] max-sm:hidden"
            />
        </section>

        {/* Reviews Section: live Google reviews, then the ones in src/data/home.json */}
        <section class="container mb-large" aria-label="Guest reviews">
            <ReviewsSlider reviews={reviews} />
        </section>

        {/* Image marquee: images live in src/data/home.json */}
        <section class="pb-large">
            <Marquee images={home.marquee} />
        </section>
    </div>
</Layout>
