---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import home from '../data/home.json';
---

<Layout title="About Us">
    <section class="py-24">
        <div class="container">
            <section
                class="min-h min-w relative flex items-center justify-center bg-[https:images.unsplash.com/photo-1514933651103-005eec06c04b?w=1000&auto=format&fit=crop&q=85] bg-cover bg-center bg-no-repeat"
            >
                <h1
                    class="heading-h2 tracking-wide uppercase"
                    data-editable="source"
                    data-path="src/pages/about.astro"
                    data-key="heroHeading"
                    data-type="text"
                >
                    A taste of passion in the heart of Pigalle
                </h1>
            </section>

            <!-- Hero / Heading Section -->
            <div class="mx-auto mb-16 max-w-4xl space-y-6 text-center">
                <span
                    class="tracking-widest"
                    data-editable="source"
                    data-path="src/pages/about.astro"
                    data-key="storyLabel"
                    data-type="text">Our Story</span
                >
                <h3 class="heading-h3"></h3>
                <p
                    data-editable="source"
                    data-path="src/pages/about.astro"
                    data-key="storyIntro"
                    data-type="text"
                >
                    Step into our Johannesburg sanctuary and dive into culinary bliss amidst the
                    cozy elegance of our dining area.
                </p>
            </div>
            <p
                class="body-base mx-auto max-w-2xl"
                data-editable="source"
                data-path="src/pages/about.astro"
                data-key="storyDescription"
                data-type="text"
            >
                Prepare your taste buds for a luscious dining experience at Pigalle where our
                masterpieces are crafted with soul and passion, delivering flavours that will leave
                you craving more.
            </p>
        </div>

        <!-- Image Grid Section (12-Column Layout) -->
        <div class="grid-12 my-16 grid items-center">
            <!-- Image 1 -->
            <div class="col-span-12 h-[400px] overflow-hidden md:col-span-4">
                <Image
                    class="h-full w-full object-cover transition-transform duration-700 hover:scale-105"
                    data-editable="image"
                    data-prop-src="@data[home].aboutImageSrc"
                    data-prop-alt="@data[home].aboutImageAlt"
                    data-prop-title="@data[home].aboutImageTitle"
                    src={home.aboutImageSrc}
                    title={home.aboutImageTitle}
                    alt={home.aboutImageAlt}
                    data-animation="image_reveal_horizontal"
                    width={1000}
                    height={1000}
                />
            </div>

            <!-- Image 2 (Slightly offset or balanced) -->
            <div class="col-span-12 h-[400px] overflow-hidden md:col-span-4">
                <Image
                    class="h-full w-full object-cover"
                    data-editable="image"
                    data-prop-src="@data[home].aboutImageSrc"
                    data-prop-alt="@data[home].aboutImageAlt"
                    data-prop-title="@data[home].aboutImageTitle"
                    src={home.aboutImageSrc}
                    title={home.aboutImageTitle}
                    alt={home.aboutImageAlt}
                    data-animation="image_reveal_horizontal"
                    width={1000}
                    height={1000}
                />
            </div>

            <!-- Image 3 -->
            <div class="col-span-12 h-[400px] overflow-hidden md:col-span-4">
                <Image
                    class="h-full w-full"
                    data-editable="image"
                    data-prop-src="@data[home].aboutImageSrc"
                    data-prop-alt="@data[home].aboutImageAlt"
                    data-prop-title="@data[home].aboutImageTitle"
                    src={home.aboutImageSrc}
                    title={home.aboutImageTitle}
                    alt={home.aboutImageAlt}
                    data-animation="image_reveal_horizontal"
                    width={1000}
                    height={1000}
                />
            </div>
        </div>

        <!-- Bottom Editorial Content Section -->
        <div class="mx-auto mt-20 max-w-3xl space-y-8 text-center">
            <h3
                class="heading-h2"
                data-editable="source"
                data-path="src/pages/about.astro"
                data-key="valuesHeading"
                data-type="text"
            >
                We take pride in our food, as we source the best ingredients locally and
                internationally.
            </h3>

            <div class="body-base space-y-4">
                <p
                    data-editable="source"
                    data-path="src/pages/about.astro"
                    data-key="valuesDescription"
                    data-type="text"
                >
                    Our restaurant is Fully Halaal and NIHT certified and driven by passion and the
                    love for good food.
                </p>
                <p
                    data-editable="source"
                    data-path="src/pages/about.astro"
                    data-key="teamDescription"
                    data-type="text"
                >
                    Our eager team of staff are always happy and ready to ensure your comfort and
                    satisfaction when you are dining with us.
                </p>
            </div>
        </div>
    </section>
</Layout>
