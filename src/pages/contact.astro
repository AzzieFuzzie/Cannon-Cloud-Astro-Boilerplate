---
import Layout from '@layouts/Layout.astro';
import { Image } from 'astro:assets';
import contact from '../data/contact.json';
import site from '../data/site.json';

const toTel = (number: string) => `tel:${number.replace(/[^+\d]/g, '')}`;

const mapQuery = encodeURIComponent(
    'UO9, Michelangelo Towers, Maude St, Sandton, 2196 (Pigalle by Villamoura)'
);
---

<Layout title="Contact">
    <section
        class="sm:grid-layout min-h-screen px-(--grid-margin) pt-small pb-medium sm:items-start md:pt-medium"
    >
        <!-- Left: heading + image -->
        <div class="flex flex-col items-center justify-center md:top-large md:col-span-5">
            <h2
                class="mb-xsmall max-w-[clamp(5ch,50%,10ch)] text-center"
                data-editable="source"
                data-path="src/pages/contact.astro"
                data-key="pageHeading"
                data-type="text"
            >
                Get in touch with us
            </h2>

            <Image
                class="mb-small aspect-665/440 w-full object-cover md:mb-0 md:aspect-square"
                data-editable="image"
                data-prop-src="@data[contact].heroImage"
                data-prop-alt="@data[contact].heroImageAlt"
                data-prop-title="@data[contact].heroImageTitle"
                src={contact.heroImage}
                title={contact.heroImageTitle}
                alt={contact.heroImageAlt}
                data-animation="image_reveal_horizontal"
                width={1000}
                height={1000}
            />
        </div>

        <!-- Right: details + map -->
        <div
            class="flex flex-col justify-center text-center sm:items-start sm:justify-start sm:text-left md:col-span-6 md:col-start-7 md:pt-[calc(var(--text-heading-h2)*1.25+var(--spacing-xsmall))]"
        >
            <ul class="">
                <li class="py-tiny first:pt-0 md:py-xsmall">
                    <h4
                        class="mb-xxtiny text-heading-h6 tracking-wider text-black/60 uppercase"
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="phoneLabel"
                        data-type="text"
                    >
                        Phone
                    </h4>
                    {
                        /* Contact details come from src/data/site.json so the link always matches the text */
                    }
                    <a
                        href={toTel(site.phone)}
                        class="body-base transition-opacity duration-(--transition-duration) ease-(--ease) hover:opacity-60"
                    >
                        <span data-editable="text" data-prop="@data[site].phone" data-type="span"
                            >{site.phone}</span
                        >
                    </a>
                </li>

                <li class="py-tiny md:py-xsmall">
                    <h4
                        class="mb-xxtiny text-heading-h6 tracking-wider text-black/60 uppercase"
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="whatsappLabel"
                        data-type="text"
                    >
                        Whatsapp
                    </h4>
                    <a
                        href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`}
                        target="_blank"
                        rel="noopener"
                        class="body-base transition-opacity duration-(--transition-duration) ease-(--ease) hover:opacity-60"
                    >
                        <span data-editable="text" data-prop="@data[site].whatsapp" data-type="span"
                            >{site.whatsapp}</span
                        >
                    </a>
                </li>

                <li class="py-tiny md:py-xsmall">
                    <h4
                        class="mb-xxtiny text-heading-h6 tracking-wider text-black/60 uppercase"
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="emailLabel"
                        data-type="text"
                    >
                        Email
                    </h4>
                    <a
                        href={`mailto:${site.email}`}
                        class="body-base transition-opacity duration-(--transition-duration) ease-(--ease) hover:opacity-60"
                    >
                        <span data-editable="text" data-prop="@data[site].email" data-type="span"
                            >{site.email}</span
                        >
                    </a>
                </li>

                <li class="py-tiny md:py-xsmall">
                    <h4
                        class="mb-xxtiny text-heading-h6 tracking-wider text-black/60 uppercase"
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="addressLabel"
                        data-type="text"
                    >
                        Address
                    </h4>
                    <a
                        href={site.mapsUrl}
                        target="_blank"
                        rel="noopener"
                        class="body-base block leading-snug transition-opacity duration-(--transition-duration) ease-(--ease) hover:opacity-60"
                    >
                        <span
                            class="block"
                            data-editable="text"
                            data-prop="@data[site].addressLine1"
                            data-type="span">{site.addressLine1}</span
                        >
                        <span
                            class="block"
                            data-editable="text"
                            data-prop="@data[site].addressLine2"
                            data-type="span">{site.addressLine2}</span
                        >
                    </a>
                </li>
            </ul>

            <iframe
                title="Map to Pigalle by Villamoura"
                src={`https://maps.google.com/maps?hl=en&q=${mapQuery}&z=15&output=embed`}
                class="mt-small aspect-4/3 w-[50%] border-0 grayscale-[0.6] md:aspect-video"
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
    </section>
</Layout>
