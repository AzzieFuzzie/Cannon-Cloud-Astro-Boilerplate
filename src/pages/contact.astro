---
import Layout from '@layouts/Layout.astro';
import DataImage from '../components/DataImage/DataImage.astro';
import Marquee from '../components/Marquee/Marquee.astro';
import Reveal from '../components/Reveal/Reveal.astro';
import TextReveal from '../components/TextReveal/TextReveal.astro';
import contact from '../data/contact.json';
import home from '../data/home.json';
import site from '../data/site.json';

import facebook from '../assets/svgs/facebook.svg';
import instagram from '../assets/svgs/instagram.svg';
import linkedin from '../assets/svgs/linkden.svg';
import x from '../assets/svgs/x.svg';

const toTel = (number: string) => `tel:${number.replace(/[^+\d]/g, '')}`;

const mapQuery = encodeURIComponent(
    'UO9, Michelangelo Towers, Maude St, Sandton, 2196 (Pigalle by Villamoura)'
);

const socials = [
    { label: 'Facebook', href: 'https://facebook.com', icon: facebook },
    { label: 'Instagram', href: 'https://www.instagram.com/pigallevillamoura/', icon: instagram },
    { label: 'X', href: 'https://x.com', icon: x },
    { label: 'LinkedIn', href: 'https://linkedin.com', icon: linkedin }
];

// Small label above a large bold value, as on pigalle.co.za.
// normal-case: links are uppercase site-wide (typography.css), but emails and addresses read better as written
const labelClass = 'body-base mb-xxtiny';
const valueClass =
    'text-heading-h5 font-bold normal-case transition-opacity duration-(--transition-duration) ease-(--ease) hover:opacity-60';
---

<Layout
    title="Contact"
    description="Find Pigalle by Villamoura at Michelangelo Towers, Maude St, Sandton. Opening hours, phone and WhatsApp."
    hideFooter
>
    {
        /* Hero: banner photo with the heading centred on top.
        It sticks to the top while the rest of the page scrolls over it */
    }
    <section
        class="sticky top-0 flex h-[clamp(260px,42vh,460px)] items-center justify-center overflow-hidden px-(--grid-margin) text-center text-white"
    >
        <DataImage
            class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[center_30%]"
            data-editable="image"
            data-prop-src="@data[contact].heroImage"
            data-prop-alt="@data[contact].heroImageAlt"
            data-prop-title="@data[contact].heroImageTitle"
            src={contact.heroImage}
            title={contact.heroImageTitle}
            alt={contact.heroImageAlt}
            sizes="100vw"
            loading="eager"
        />
        {/* Light shade so the white heading reads on any photo */}
        <div class="absolute inset-0 bg-black/20" aria-hidden="true"></div>

        <TextReveal type="chars" class="relative z-10">
            <h1
                class="heading-h1"
                data-editable="source"
                data-path="src/pages/contact.astro"
                data-key="pageHeading"
                data-type="span"
            >
                Get <em>in</em> touch <em>with</em> us
            </h1>
        </TextReveal>
    </section>

    {/* Everything below slides over the hero, so it needs its own background */}
    <div class="relative z-10 bg-(--color-grey)">
        {
            /* Details on the page grid (the dev grid helper): phone and email on the left; socials,
            address and map on the right. Phones: full width, stacked. Tablets: a half each.
            From 1200px: columns 2–5 and 8–11, a column in from each edge with two between them */
        }
        <section
            class="grid-layout container gap-y-small pt-small pb-medium"
            data-track-area="contact-details"
        >
            <ul
                class="col-span-4 flex flex-col gap-xsmall sm:col-span-6 lg:col-span-4 lg:col-start-2"
            >
                <li>
                    <p
                        class={labelClass}
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="phoneLabel"
                        data-type="text"
                    >
                        Phone
                    </p>
                    {
                        /* Contact details come from src/data/site.json so the link always matches the text */
                    }
                    <a href={toTel(site.phone)} class={valueClass}>
                        <span data-editable="text" data-prop="@data[site].phone" data-type="span"
                            >{site.phone}</span
                        >
                    </a>
                </li>

                <li>
                    <p
                        class={labelClass}
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="whatsappLabel"
                        data-type="text"
                    >
                        WhatsApp
                    </p>
                    <a
                        href={`https://wa.me/${site.whatsapp.replace(/\D/g, '')}`}
                        target="_blank"
                        rel="noopener"
                        class={valueClass}
                    >
                        <span data-editable="text" data-prop="@data[site].whatsapp" data-type="span"
                            >{site.whatsapp}</span
                        >
                    </a>
                </li>

                <li>
                    <p
                        class={labelClass}
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="emailLabel"
                        data-type="text"
                    >
                        Email
                    </p>
                    <a href={`mailto:${site.email}`} class={valueClass}>
                        <span data-editable="text" data-prop="@data[site].email" data-type="span"
                            >{site.email}</span
                        >
                    </a>
                </li>

                <li>
                    <p
                        class={labelClass}
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="hoursLabel"
                        data-type="text"
                    >
                        Trading Hours
                    </p>
                    {
                        /* Trading hours live in src/data/site.json (the footer, hidden on this page, uses them too) */
                    }
                    <ul
                        class="flex max-w-[24rem] flex-col gap-xxtiny text-heading-h5 font-bold"
                        data-editable="array"
                        data-prop="@data[site].hours"
                    >
                        {
                            site.hours.map((row) => (
                                <li
                                    class="flex justify-between gap-tiny"
                                    data-editable="array-item"
                                >
                                    <span data-editable="text" data-prop="days" data-type="span">
                                        {row.days}
                                    </span>
                                    <span data-editable="text" data-prop="time" data-type="span">
                                        {row.time}
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </li>
            </ul>

            <div
                class="col-span-4 flex flex-col gap-small sm:col-span-6 lg:col-span-4 lg:col-start-8"
            >
                <div>
                    <p
                        class={labelClass}
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="socialLabel"
                        data-type="text"
                    >
                        Follow us
                    </p>
                    <ul class="mt-xtiny flex items-center gap-tiny">
                        {
                            socials.map(({ label, href, icon }) => (
                                <li>
                                    <a
                                        href={href}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label={label}
                                        class="block transition-opacity duration-(--transition-duration) ease-(--ease) hover:opacity-60"
                                    >
                                        {/* The icon files are white (made for the black footer); brightness-0 turns them black */}
                                        <img
                                            src={icon.src}
                                            alt=""
                                            width="28"
                                            height="28"
                                            class="size-7 brightness-0"
                                        />
                                    </a>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <div>
                    <p
                        class={labelClass}
                        data-editable="source"
                        data-path="src/pages/contact.astro"
                        data-key="addressLabel"
                        data-type="text"
                    >
                        Address
                    </p>
                    <a
                        href={site.mapsUrl}
                        target="_blank"
                        rel="noopener"
                        class={`block ${valueClass}`}
                    >
                        <span
                            data-editable="text"
                            data-prop="@data[site].addressLine1"
                            data-type="span">{site.addressLine1}</span
                        >
                        <span
                            data-editable="text"
                            data-prop="@data[site].addressLine2"
                            data-type="span">{site.addressLine2}</span
                        >
                    </a>

                    <Reveal type="fade" class="mt-xtiny">
                        <iframe
                            title="Map to Pigalle by Villamoura"
                            src={`https://maps.google.com/maps?hl=en&q=${mapQuery}&z=15&output=embed`}
                            class="aspect-2/1 w-full max-w-[360px] rounded-[4px] border-0"
                            loading="lazy"
                            referrerpolicy="no-referrer-when-downgrade"></iframe>
                    </Reveal>
                </div>
            </div>
        </section>

        {/* Image marquee: the same images as the home page (src/data/home.json) */}
        <section class="pb-medium">
            <Marquee images={home.marquee} />
        </section>
    </div>
</Layout>
