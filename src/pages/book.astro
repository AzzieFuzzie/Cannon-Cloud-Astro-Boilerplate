---
import Layout from '@layouts/Layout.astro';
import Image from '../components/Image/Image.astro';
import home from '../data/home.json';
---

<Layout title="Reservation">
    <div class="container py-fluid-xl">
        <section
            class="flex h-screen w-screen flex-col items-center justify-center bg-[url('https:images.unsplash.com/photo-1514933651103-005eec06c04b?w=1000&auto=format&fit=crop&q=85')] text-center text-white"
        >
            <p class="heading-h1 mb-fluid-xs font-medium tracking-widest uppercase">
                Book Your Experience
            </p>
            <p class="body-base mt-fluid-md max-w-[42ch]">
                Experience an unforgettable dining journey in the heart of Sandton. Complete the
                form below to request your reservation, or connect with our maître d' directly.
            </p>
        </section>

        <section class="section-spacing-xl flex flex-col items-center justify-center text-center">
            <h2 class="heading-h5 mb-fluid-sm">
                Complete the form below to book your reservation, or connect with our maître d'
                directly.
            </h2>
            <div class="space-y-2 text-sm">
                <p>
                    <a class="heading-h4" href="tel:+27118848899"> +27 11 884 8899 </a>
                </p>
                <p>
                    <a class="heading-h4" href="tel:+27845567786"> +27 84 556 7786 </a>
                </p>
                <p>
                    <a class="heading-h4 uppercase" href="mailto:info@pigalle.co.za">
                        info@pigalle.co.za
                    </a>
                </p>
            </div>
        </section>
    </div>
</Layout>
