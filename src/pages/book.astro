---
import Layout from '@layouts/Layout.astro';
import DataImage from '../components/DataImage/DataImage.astro';
import TextReveal from '../components/TextReveal/TextReveal.astro';
import book from '../data/book.json';
import site from '../data/site.json';

const toTel = (number: string) => `tel:${number.replace(/[^+\d]/g, '')}`;
---

<Layout title="Reservation">
    <div class="">
        {
            /* Intro: half-screen image with the heading and description on top.
            It sticks to the top while the booking section scrolls over it */
        }
        <section
            class="sticky top-0 flex min-h-[50vh] flex-col items-center justify-center overflow-hidden px-(--grid-margin) py-small text-center text-white [text-shadow:0_2px_10px_rgba(0,0,0,0.2)]"
        >
            <DataImage
                class="pointer-events-none absolute inset-0 h-full w-full object-cover"
                data-editable="image"
                data-prop-src="@data[book].heroImage"
                data-prop-alt="@data[book].heroImageAlt"
                data-prop-title="@data[book].heroImageTitle"
                src={book.heroImage}
                title={book.heroImageTitle}
                alt={book.heroImageAlt}
                sizes="100vw"
                loading="eager"
            />

            <div class="relative z-10 flex flex-col items-center">
                <TextReveal type="chars">
                    <h1
                        class="heading-h1"
                        data-editable="source"
                        data-path="src/pages/book.astro"
                        data-key="heroHeading"
                        data-type="text"
                    >
                        Book Your Experience
                    </h1>
                </TextReveal>

                <p
                    class="mt-xsmall max-w-[clamp(30ch,70%,50ch)] text-body-base leading-relaxed"
                    data-editable="source"
                    data-path="src/pages/book.astro"
                    data-key="heroDescription"
                    data-type="text"
                >
                    Secure your table at Pigalle Villamoura Sandton and experience an unforgettable
                    dining journey.
                </p>
            </div>
        </section>

        {/* Booking: contacts and the Dineplan form */}
        <section
            class="relative z-10 flex flex-col items-center bg-(--color-grey) px-(--grid-margin) py-small text-center"
        >
            <p
                class="mb-small max-w-[48ch] text-body-base leading-relaxed text-black/60"
                data-editable="source"
                data-path="src/pages/book.astro"
                data-key="bookingHeading"
                data-type="text"
            >
                Complete the form below to book your reservation, or connect with our maître d'
                directly.
            </p>

            <div class="flex flex-wrap items-baseline justify-center gap-y-xxtiny">
                {
                    /* Contact details come from src/data/site.json so the link always matches the text */
                }
                <a
                    href={toTel(site.phone)}
                    class="font-rd-narrow text-heading-h4 whitespace-nowrap transition-opacity duration-(--transition-duration) ease-(--ease) hover:opacity-60"
                >
                    <span data-editable="text" data-prop="@data[site].phone" data-type="span"
                        >{site.phone}</span
                    >
                </a>
                <span
                    class="text-muted mx-xtiny text-action select-none md:mx-tiny"
                    aria-hidden="true">/</span
                >
                <a
                    href={toTel(site.whatsapp)}
                    class="font-rd-narrow text-heading-h4 whitespace-nowrap transition-opacity duration-(--transition-duration) ease-(--ease) hover:opacity-60"
                >
                    <span data-editable="text" data-prop="@data[site].whatsapp" data-type="span"
                        >{site.whatsapp}</span
                    >
                </a>
                <span
                    class="text-muted mx-xtiny text-action select-none md:mx-tiny"
                    aria-hidden="true">/</span
                >
                <a
                    href={`mailto:${site.email}`}
                    class="font-rd-narrow text-heading-h4 whitespace-nowrap transition-opacity duration-(--transition-duration) ease-(--ease) hover:opacity-60"
                >
                    <span data-editable="text" data-prop="@data[site].email" data-type="span"
                        >{site.email}</span
                    >
                </a>
            </div>

            {/* The "form below" the intro text refers to */}
            <div class="mt-small h-[600px] w-full max-w-[650px] sm:h-[520px]">
                <iframe
                    src="https://account.dineplan.com/widget/v3/frame/mnpTxlcs"
                    title="Book a table at Pigalle"
                    loading="lazy"
                    class="h-full w-full rounded-[10px] border-2 border-(--color-accent-grey) sm:border-[5px]"
                ></iframe>
            </div>
        </section>
    </div>
</Layout>
